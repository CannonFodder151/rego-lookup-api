# API key clients must send to this endpoint (X-API-Key header or Bearer token)
# Replace with a real long random value before deploying. CI refuses to deploy
# while API_KEY is still this placeholder or "change-me".
API_KEY=<generate-long-random>

# Comma-separated IPs/CIDRs of reverse proxies allowed to set X-Forwarded-For.
# Unset: XFF is ignored and the socket address keys the per-IP rate limit.
# TRUSTED_PROXIES=172.18.0.0/16
